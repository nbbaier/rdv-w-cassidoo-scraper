{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "plugins": ["./biome-plugins/no-nested-multiline-template.grit"],
      "linter": {
        "rules": {
          "nursery": { "useTailwindSortedClasses": "off" },
          "style": { "useFilenamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["scraper/**/*.ts"],
      "javascript": {
        "globals": ["Bun"]
      }
    },
    {
      // astro:content is a Vite virtual module. Biome resolves imports on disk, so this specifier is always "module not found".
      "includes": ["src/content.config.ts", "src/pages/search.json.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    }
  ],
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/astro",
    "ultracite/biome/vitest",
    "ultracite/biome/type-aware"
  ],
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "on"
      }
    }
  }
}
